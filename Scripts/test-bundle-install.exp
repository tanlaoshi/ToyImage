set timeout 120
spawn ./Scripts/run-split.sh --kill-qemu --headless --smp=1
expect {
    -re "ToyOS ready|就绪" {}
    timeout { puts "boot timeout"; exit 1 }
}
send "\r"
expect -re "toyos>"
proc run {Cmd} {
    set timeout 90
    send "$Cmd\r"
    expect {
        -re "toyos>" { return $expect_out(buffer) }
        timeout { puts "timeout after: $Cmd"; exit 1 }
    }
}
proc wait_job {} {
    for {set i 0} {$i < 120} {incr i} {
        set b [run "store job"]
        if {[regexp {store job: idle} $b]} { return $b }
    }
    puts "FAIL never idle"; exit 1
}

run "store install hello"
wait_job
set b [run "stat Apps/hello/HELLO.ELF"]
puts $b
if {![regexp {size|Size|Attr|cluster|file} $b]} { puts "FAIL hello stat"; exit 1 }
puts "ok hello bundle"

run "store install sun8"
wait_job
run "store install demopack"
wait_job
run "store install guidemo"
wait_job
set b [run "stat Apps/guidemo/GUIDEMO.ELF"]
puts $b
if {![regexp {size|Size|Attr|cluster|file} $b]} { puts "FAIL guidemo elf"; exit 1 }
set b [run "stat Apps/guidemo/PKG.TXT"]
puts $b
if {![regexp {size|Size|Attr|cluster|file} $b]} { puts "FAIL guidemo pkg"; exit 1 }
puts "ok guidemo bundle"

send "halt\r"
catch { exec pkill -9 -f qemu-system-x86_64 }
puts "=== PASS ==="
exit 0
